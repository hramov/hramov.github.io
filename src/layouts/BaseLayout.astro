---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Блог про бэкенд, архитектуру и инженерные решения",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href="/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">backend<span>/</span>notes</a>
        <nav class="nav">
          <a href="/">Блог</a>
          <a href="/resume">Резюме</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        © {new Date().getFullYear()} - Храмов Сергей
      </div>
    </footer>

    <!-- Mermaid: рисует все <pre class="mermaid"> на клиенте. -->
    <script>
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      mermaid.initialize({
        startOnLoad: true,
        theme: "neutral",
        fontFamily: "JetBrains Mono, monospace",
      });
    </script>
  </body>
</html>
