---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Блог про бэкенд, архитектуру и инженерные решения",
} = Astro.props;

const resumeUrl =
  "https://barnaul.hh.ru/resume/3bb845edff085c77380039ed1f503377556645";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href="/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">backend<span>/</span>notes</a>
        <nav class="nav">
          <a href="/">Блог</a>
          <a href="/ideas">Идеи</a>
          <a href={resumeUrl} target="_blank">Резюме</a>
          <a href="/rss.xml" target="_blank">RSS</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        © {new Date().getFullYear()} - Храмов Сергей, Backend Developer
      </div>
    </footer>
  </body>
</html>
